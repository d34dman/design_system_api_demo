{#
/**
 * @file
 * Primary and secondary tabs.
 */
#}
{% if primary %}
  <h2 class="visually-hidden">{{ 'Primary tabs'|t }}</h2>
  <ul class="tabs tabs--primary ds-tabs">{{ primary }}</ul>
{% endif %}
{% if secondary %}
  <h2 class="visually-hidden">{{ 'Secondary tabs'|t }}</h2>
  <ul class="tabs tabs--secondary ds-segmented">{{ secondary }}</ul>
{% endif %}
