{#
/**
 * @file
 * Primary and secondary tabs: page tabs, and the small tab row for the
 * views within a page (Overview / Moderated content).
 */
#}
{% if primary %}
  <h2 class="visually-hidden">{{ 'Primary tabs'|t }}</h2>
  <ul class="tabs tabs--primary ds-tabs">{{ primary }}</ul>
{% endif %}
{% if secondary %}
  <h2 class="visually-hidden">{{ 'Secondary tabs'|t }}</h2>
  <ul class="tabs tabs--secondary ds-tabs ds-tabs--small">{{ secondary }}</ul>
{% endif %}
