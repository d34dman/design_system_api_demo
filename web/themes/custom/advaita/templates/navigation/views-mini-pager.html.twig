{#
/**
 * @file
 * A views mini pager: the pager pattern, as pager.html.twig. Previous and
 * next are the contract's chevron, the current page a label between them.
 */
#}
{% set chevron = include('design_system_api:icon', {name: 'chevron'}, with_context = false) %}
{% if items.previous or items.next %}
  <nav{{ attributes.addClass('pager', 'pager--mini') }} aria-labelledby="{{ heading_id }}">
    <{{ pagination_heading_level }} id="{{ heading_id }}" class="visually-hidden">{{ 'Pagination'|t }}</{{ pagination_heading_level }}>
    <ul class="pager__items js-pager__items">
      {% if items.previous %}
        <li class="pager__item pager__item--previous">
          <a href="{{ items.previous.href }}" title="{{ 'Go to previous page'|t }}" rel="prev"{{ items.previous.attributes|without('href', 'title', 'rel') }}>
            {{- chevron -}}
            <span class="visually-hidden">{{ 'Previous page'|t }}</span>
          </a>
        </li>
      {% endif %}
      {% if items.current %}
        <li class="pager__item pager__item--current" aria-current="page">
          {% trans %}
            Page {{ items.current }}
          {% endtrans %}
        </li>
      {% endif %}
      {% if items.next %}
        <li class="pager__item pager__item--next">
          <a href="{{ items.next.href }}" title="{{ 'Go to next page'|t }}" rel="next"{{ items.next.attributes|without('href', 'title', 'rel') }}>
            <span class="visually-hidden">{{ 'Next page'|t }}</span>
            {{- chevron -}}
          </a>
        </li>
      {% endif %}
    </ul>
  </nav>
{% endif %}
