<?php

/**
 * @file
 * Advaita: one component library, two design systems.
 *
 * Admin routes render in the admin system, every other page in the site's.
 * Which values a system gets is the Design System API's business: the theme
 * carries no values. Its skins (advaita.skins.yml) are bound to the site and
 * the chrome by the site (drush ds:bind); the theme only picks the page shell.
 */

declare(strict_types=1);

/**
 * Whether the current route is an admin route.
 */
function _advaita_is_admin(): bool {
  return \Drupal::service('router.admin_context')->isAdminRoute();
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function advaita_theme_suggestions_page_alter(array &$suggestions): void {
  if (_advaita_is_admin()) {
    $suggestions[] = 'page__advaita_admin';
  }
}

/**
 * Implements hook_preprocess_html().
 */
function advaita_preprocess_html(array &$variables): void {
  $variables['attributes']['class'][] = _advaita_is_admin() ? 'advaita-admin' : 'advaita-site';
  // Core builds the dropbutton toggle, the tabledrag handle and the dialog's
  // close button in JavaScript. The page carries their icons once, from the
  // Design System API's icon component, for js/icons.js to clone. The markup
  // fits any context: the component picks each context's skin icons in CSS.
  foreach (['chevron', 'close', 'drag'] as $name) {
    $variables['page_bottom']['advaita_icons'][$name] = [
      '#type' => 'inline_template',
      '#template' => '<template data-advaita-icon="{{ name }}">{{ icon }}</template>',
      '#context' => [
        'name' => $name,
        'icon' => [
          '#type' => 'component',
          '#component' => 'design_system_api:icon',
          '#props' => ['name' => $name],
        ],
      ],
    ];
  }
}

/**
 * Implements hook_preprocess_page().
 */
function advaita_preprocess_page(array &$variables): void {
  $variables['site_name'] = \Drupal::config('system.site')->get('name');
}

/**
 * Implements hook_preprocess_menu_local_task().
 */
function advaita_preprocess_menu_local_task(array &$variables): void {
  $variables['attributes']['class'][] = 'tabs__tab';
  if (!empty($variables['is_active'])) {
    $variables['attributes']['class'][] = 'is-active';
    $variables['link']['#options']['attributes']['aria-current'] = 'page';
  }
}

/**
 * Implements hook_preprocess_status_messages().
 */
function advaita_preprocess_status_messages(array &$variables): void {
  $variables['icons'] = ['status' => 'check', 'warning' => 'alert', 'error' => 'x'];
}

/**
 * Implements hook_preprocess_details().
 */
function advaita_preprocess_details(array &$variables): void {
  $variables['attributes']['class'][] = 'details';
}

/**
 * Implements hook_preprocess_table().
 */
function advaita_preprocess_table(array &$variables): void {
  $variables['attributes']['class'][] = 'table';
}

/**
 * Implements hook_form_alter().
 *
 * Primary buttons of a form's actions keep core's own classes; the actions
 * row gets one so it can be sticky in the admin system.
 */
function advaita_form_alter(array &$form): void {
  if (isset($form['actions']) && is_array($form['actions'])) {
    $form['actions']['#attributes']['class'][] = 'form-actions';
  }
}

/**
 * Implements hook_preprocess_block().
 *
 * Core's block template adds no classes; components need the plugin's.
 */
function advaita_preprocess_block(array &$variables): void {
  $variables['attributes']['class'][] = 'block';
  $variables['attributes']['class'][] = \Drupal\Component\Utility\Html::getClass('block-' . $variables['plugin_id']);
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 *
 * The settings sit beside the content as a stack of details, as vertical
 * tabs need more width than a sidebar has.
 */
function advaita_form_node_form_alter(array &$form): void {
  $form['#theme'] = ['node_edit_form'];
  if (isset($form['advanced'])) {
    $form['advanced']['#type'] = 'container';
    $form['advanced']['#attributes']['class'][] = 'entity-form__settings';
  }
  if (isset($form['meta'])) {
    $form['meta']['#type'] = 'details';
    $form['meta']['#open'] = TRUE;
    $form['meta']['#weight'] = -10;
  }
}
