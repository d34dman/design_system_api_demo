{
    "name": "d34dman/design_system_api_demo",
    "description": "Demo site for the Drupal Design System API: one contract, admin and frontend themes.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/design_system_api",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.3",
        "drupal/admin_toolbar": "^3.6",
        "drupal/canvas": "^1.12",
        "drupal/chosen": "^5.0",
        "drupal/clientside_validation": "^4.1",
        "drupal/coffee": "^2.0",
        "drupal/core-composer-scaffold": "11.5.0-beta1",
        "drupal/core-recommended": "11.5.0-beta1",
        "drupal/design_system_api": "1.0.x-dev@dev",
        "drupal/environment_indicator": "^4.0",
        "drupal/eu_cookie_compliance": "^1.29",
        "drupal/field_group": "^4.0",
        "drupal/gin": "^5.0",
        "drupal/gin_toolbar": "^3.0",
        "drupal/inline_entity_form": "^3.0",
        "drupal/klaro": "^3.1",
        "drupal/layout_paragraphs": "^3.0",
        "drupal/linkit": "^7.0",
        "drupal/masquerade": "^2.2",
        "drupal/mercury_editor": "^3.0",
        "drupal/moderation_sidebar": "^1.8",
        "drupal/paragraphs": "^1.23",
        "drupal/select2": "^2.0",
        "drupal/sitewide_alert": "^3.1",
        "drupal/webform": "^6.3",
        "drush/drush": "^13.8"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "recipes/{$name}": [
                "type:drupal-recipe"
            ]
        }
    },
    "require-dev": {
        "drupal/core-dev": "11.5.0-beta1"
    }
}
