# Ignore directories generated by Composer
/drush/contrib/
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/recipes/*
!/recipes/design_system_api_demo_content/

# Drupal scaffold files (regenerated by composer install)
/web/*.php
/web/*.txt
/web/.ht.router.php
/web/.htaccess
/web/sites/default/default.*
/web/sites/example.*
/web/sites/*.php
/web/sites/*.yml

# Sensitive and generated site files
/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/settings.ddev.php
/web/sites/*/files/
/web/sites/simpletest

# Workspace mode (generated by `ddev workspace-mode on`)
/composer.workspace.json
/composer.workspace.lock
/.ddev/docker-compose.workspace.yaml

# Agent context, materialized from the workspace (scripts/fw.postsync)
/CLAUDE.md
/.claude/

# Local
.env
.idea/
.vscode/
.DS_Store
.playwright-mcp
node_modules

# Proof gallery (generated by tests/proof)
/tests/proof/node_modules/
/tests/proof/out/
/design-system/registry/
