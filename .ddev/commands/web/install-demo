#!/usr/bin/env bash

## Description: Install the Design System API demo site from scratch and print a login link
## Usage: install-demo
## Example: "ddev install-demo"

set -euo pipefail

composer install --no-interaction
drush site:install standard --account-name=admin --account-pass=admin \
  --site-name="Design System API demo" -y
# Standard installs only Default Admin; Olivero and Claro are core themes on 11.5.
drush theme:install olivero default_admin claro -y
drush config:set system.theme default olivero -y
drush config:set system.theme admin default_admin -y
# Standard points the front page at /admin/welcome when there is no frontend theme,
# and ships the /node listing (promoted_content) disabled.
drush views:enable promoted_content
drush config:set system.site page.front /node -y
# The stage: Article type, image media, Media Library widget, Arabic (RTL),
# content editing in the frontend theme.
drush recipe ../recipes/design_system_api_demo_content
drush pm:install design_system_api design_system_api_ui design_system_api_default_admin design_system_api_claro design_system_api_media_library design_system_api_chrome -y
# Everything else the demo shows: the editorial workflow, the contrib UIs, Canvas,
# the Advaita theme and its dashboard, the landing page types. It needs the module.
drush recipe ../recipes/design_system_api_demo_showcase
# The content last, so articles are moderated and the landing pages have their types.
drush php:script ../scripts/demo-content.php
drush cache:rebuild

echo
echo "Frontend theme: Olivero. Admin theme: Default Admin. Advaita is installed: ddev demo colour."
echo "Switch with: ddev admin-theme <default_admin|claro>, ddev frontend-theme <olivero|stark>"
echo "Open this link to log in:"
drush user:login
