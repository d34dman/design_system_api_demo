#!/usr/bin/env bash

## Description: Switch the frontend theme, to see contract-based UI in a theme that has never heard of it
## Usage: frontend-theme [theme-machine-name]
## Example: "ddev frontend-theme stark"

set -euo pipefail

if [ $# -eq 0 ]; then
  echo "Current frontend theme: $(drush config:get system.theme default --format=string)"
  exit 0
fi

drush theme:install "$1" -y
drush config:set system.theme default "$1" -y
drush cache:rebuild
echo "Frontend theme is now: $1"
