#!/usr/bin/env bash

## Description: Lint the Media Library pilot CSS (passes) and a seeded bad file (fails) with the Design System API's stylelint rules (proof moment 6)
## Usage: ds-lint [files...]
## Example: "ddev ds-lint"

set -uo pipefail

cd "$DDEV_APPROOT"
TOOL="web/modules/contrib/design_system_api/tooling/stylelint"
if [ ! -d "$TOOL" ]; then
  echo "Design System API not found at $TOOL." >&2
  exit 1
fi
if [ ! -d "$TOOL/node_modules" ]; then
  (cd "$TOOL" && npm install --silent)
fi
STYLELINT="$TOOL/node_modules/.bin/stylelint"

if [ $# -gt 0 ]; then
  "$STYLELINT" --config "$TOOL/index.js" "$@"
  exit $?
fi

echo "== Pilot CSS (expected: pass)"
"$STYLELINT" --config "$TOOL/index.js" "web/modules/contrib/design_system_api/modules/design_system_api_media_library/css/*.css" \
  && echo "✔ no problems"
echo
echo "== Seeded bad file (expected: fail)"
"$STYLELINT" --config "$TOOL/index.js" tests/lint/seeded-bad.css
echo
echo "== Receipts: hex values and theme names in the pilot submodule"
PILOT="web/modules/contrib/design_system_api/modules/design_system_api_media_library"
echo "hex colors:   $(grep -rEoi '#[0-9a-f]{3,8}\b' "$PILOT" --include='*.css' | wc -l | tr -d ' ')"
echo "theme names:  $(grep -rEiw --exclude-dir=tests 'default_admin|claro|olivero|gin|stark' "$PILOT" | wc -l | tr -d ' ')"
echo "pilot CSS:    $(cat "$PILOT"/css/*.css | wc -l | tr -d ' ') lines, replacing $(ls web/core/themes/default_admin/css/components/media-library*.css | grep -v pcss | xargs cat | wc -l | tr -d ' ') (Default Admin) + $(cat web/themes/contrib/claro/css/theme/media-library.css web/themes/contrib/claro/css/components/media-library.ui.css 2>/dev/null | wc -l | tr -d ' ') (Claro) lines of theme CSS"
