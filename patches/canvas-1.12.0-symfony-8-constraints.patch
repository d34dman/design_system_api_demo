+++ b/src/Plugin/Validation/Constraint/NamedOptionsTrait.php
@@ -0,0 +1,39 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\canvas\Plugin\Validation\Constraint;
+
+use Symfony\Component\Validator\Exception\InvalidOptionsException;
+use Symfony\Component\Validator\Exception\MissingOptionsException;
+
+/**
+ * Takes constraint options as named arguments, as Drupal 12 passes them.
+ *
+ * Drupal 12's ConstraintFactory calls `new $class(...$configuration)`, and
+ * Symfony Validator 8 no longer reads an options array, so options declared
+ * as public properties must be set by the constructor.
+ */
+trait NamedOptionsTrait {
+
+  public function __construct(mixed ...$options) {
+    $groups = $options['groups'] ?? NULL;
+    $payload = $options['payload'] ?? NULL;
+    unset($options['groups'], $options['payload']);
+    parent::__construct(groups: $groups, payload: $payload);
+    $invalid = array_filter(array_keys($options), fn (string $name): bool => !property_exists($this, $name));
+    if ($invalid) {
+      throw new InvalidOptionsException(\sprintf('The options "%s" do not exist in constraint "%s".', implode('", "', $invalid), static::class), $invalid);
+    }
+    foreach ($options as $name => $value) {
+      $this->{$name} = $value;
+    }
+    // Symfony 8 dropped getRequiredOptions(); classes that declare it keep it.
+    $required = method_exists($this, 'getRequiredOptions') ? $this->getRequiredOptions() : [];
+    $missing = array_diff($required, array_keys($options));
+    if ($missing) {
+      throw new MissingOptionsException(\sprintf('The options "%s" must be set for constraint "%s".', implode('", "', $missing), static::class), $missing);
+    }
+  }
+
+}
